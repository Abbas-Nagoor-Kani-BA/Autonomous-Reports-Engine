{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "checkJs": false
  },
  "include": [
    "types/global.d.ts",
    "lib/**/*.ts",
    "core/**/*.ts",
    "di/**/*.ts",
    "data/**/*.ts",
    "services/**/*.ts",
    "common/**/*.ts",
    "platform/**/*.ts",
    "panel/**/*.ts",
    "settings/**/*.ts",
    "sctask/**/*.ts",
    "viewer/**/*.ts",
    "worker/**/*.ts"
  ],
  "exclude": ["**/vendor/**", "dist/**", "node_modules/**", "tools/**"]
}
